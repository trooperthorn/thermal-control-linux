[Unit]
Description=Thermal Control Linux fan controller
After=local-fs.target
# The status file is read by hostwatch; the service has no network dependency.

[Service]
# The service sends READY=1 and WATCHDOG=1 itself over NOTIFY_SOCKET.
Type=notify
NotifyAccess=main
ExecStart=/opt/thermalctl/venv/bin/thermalctl run --config /etc/thermalctl/config.toml
# Runs after the service ends for any reason, including SIGKILL and a watchdog kill, and
# puts every fan back to the mode recorded at start. --force skips the lock check, which
# would otherwise refuse while the service is still shutting down.
ExecStopPost=/opt/thermalctl/venv/bin/thermalctl restore --force --config /etc/thermalctl/config.toml
Restart=always
RestartSec=2
# The loop pings every cycle (2 s). A hung loop is killed after 30 s and restarted.
WatchdogSec=30
RuntimeDirectory=thermalctl
RuntimeDirectoryPreserve=yes
TimeoutStopSec=20
User=root
# Hardening that leaves the sysfs pwm and pwm_enable writes alone. Deliberately absent:
# ProtectKernelTunables, PrivateDevices and ProtectSystem=strict, any of which can make /sys
# read-only or hide it from the service, which would stop it writing fan duty. The service
# only reads /etc, writes under /run/thermalctl, and talks to systemd over a unix socket.
# UNVERIFIED.md lists these settings until they are tested on the target hosts.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
